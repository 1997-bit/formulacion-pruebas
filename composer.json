{
  "name": "equipo/casos-prueba",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "monolog/monolog": "^3",
    "tecnickcom/tcpdf": "^6.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "App\\Config\\": "config/",
      "App\\Core\\": "core/",
      "App\\Models\\": "models/",
      "App\\Controllers\\": "controllers/",
      "App\\Helpers\\": "helpers/",
      "App\\Services\\": "services/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M",
    "fix": [
      "@putenv PHP_CS_FIXER_IGNORE_ENV=1",
      "php-cs-fixer fix"
    ],
    "lint": [
      "@putenv PHP_CS_FIXER_IGNORE_ENV=1",
      "php-cs-fixer fix --dry-run --diff"
    ]
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
